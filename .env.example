# API Keys for Translation Services
# Copy this file to .env and add your actual API keys

# Anthropic Claude API
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepInfra API (or any OpenAI-compatible provider)
# Get your key from: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# Embedding server for sentence alignment (optional)
# The bearer key scripts/embed_server.py was started with; used when
# alignment.embed_url is set in app_config.json
ALIGN_EMBED_KEY=

# Local inference server (optional)
# The bearer key llama-server was started with (--api-key-file); used by the
# save check when save_check.model is set in app_config.json, and by a `local`
# provider in llm_config.json (the reader's Retranslate)
LOCAL_LLM_KEY=
