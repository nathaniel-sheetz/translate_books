{
  "patterns": {
    "roman": {
      "label": "Roman numerals (Chapter I, Chapter II...)",
      "regex": "^\\s*chapter\\s+([IVXLCDM]+)[\\.:,\\s]*$",
      "flags": ["IGNORECASE", "MULTILINE"],
      "numbering": "roman",
      "detect_regex": "\\b(chapter|chapitre|cap[íi]tulo)\\s+[IVXLCDM]+[\\.:,\\s]*$",
      "detect_min_ratio": null
    },
    "numeric": {
      "label": "Numeric (Chapter 1, Chapter 2...)",
      "regex": "^\\s*chapter\\s+(\\d+)[\\.:,\\s]*$",
      "flags": ["IGNORECASE", "MULTILINE"],
      "numbering": "numeric",
      "detect_regex": "\\b(chapter|chapitre|cap[íi]tulo)\\s+\\d+[\\.:,\\s]*$",
      "detect_min_ratio": null
    },
    "chapter_roman_titled": {
      "label": "Roman + optional title (CHAPTER I SOME TITLE / CHAPTER I)",
      "regex": "^[ \\t]*chapter[ \\t]+([IVXLCDM]+)(?:[ \\t\\.:,\\-\\u2014]+(.+?))?[ \\t]*$",
      "flags": ["IGNORECASE", "MULTILINE"],
      "numbering": "roman",
      "detect_regex": "\\bchapter\\s+[IVXLCDM]+\\s+[A-Za-z]",
      "detect_min_ratio": null
    },
    "chapter_numeric_titled": {
      "label": "Numeric + optional title (CHAPTER 1 SOME TITLE / CHAPTER 1)",
      "regex": "^[ \\t]*chapter[ \\t]+(\\d+)(?:[ \\t\\.:,\\-\\u2014]+(.+?))?[ \\t]*$",
      "flags": ["IGNORECASE", "MULTILINE"],
      "numbering": "numeric",
      "detect_regex": "\\bchapter\\s+\\d+\\s+[A-Za-z]",
      "detect_min_ratio": null
    },
    "allcaps_heading": {
      "label": "All-caps section headings",
      "regex": "(?<=\\n\\n)([A-Z][A-Z .,'!?&\\u2014\\-]{2,})(?=\\n\\n)",
      "flags": [],
      "numbering": "sequential",
      "detect_regex": "^[A-Z][A-Z .,'!?&\\u2014\\-]{2,}$",
      "detect_min_ratio": 0.5
    },
    "bare_roman": {
      "label": "Bare Roman numerals (I, II, III...)",
      "regex": "^([IVXLCDM]+)$",
      "flags": ["MULTILINE"],
      "numbering": "roman",
      "detect_regex": "^[IVXLCDM]+$",
      "detect_min_ratio": 0.5
    }
  },
  "detection_order": [
    "chapter_roman_titled",
    "chapter_numeric_titled",
    "bare_roman",
    "allcaps_heading"
  ],
  "front_matter_patterns": [
    "^\\s*preface\\s*$",
    "^\\s*foreword\\s*$",
    "^\\s*prologue\\s*$",
    "^\\s*introduction\\s*$",
    "^\\s*note\\s+to\\s+(the\\s+)?reader\\s*$",
    "^\\s*dedication\\s*$",
    "^\\s*acknowledge?ments\\s*$",
    "^\\s*author'?s\\s+note\\s*$"
  ],
  "back_matter_patterns": [
    "^\\s*epilogue\\s*$",
    "^\\s*afterword\\s*$",
    "^\\s*appendix(\\s+[A-Z0-9]+)?\\s*$",
    "^\\s*colophon\\s*$",
    "^\\s*bibliography\\s*$"
  ],
  "drop_matter_patterns": [
    "^\\s*contents\\s*$",
    "^\\s*table\\s+of\\s+contents\\s*$",
    "^\\s*list\\s+of\\s+illustrations\\s*$",
    "^\\s*illustrations\\s*$",
    "^\\s*title\\s+page\\s*$",
    "^\\s*copyright\\s*$",
    "^\\s*transcriber'?s\\s+note\\s*$"
  ]
}
