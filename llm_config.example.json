{
  "default_provider": "anthropic",
  "default_model": "claude-sonnet-5",
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic (Claude)",
      "type": "anthropic",
      "api_key_env_var": "ANTHROPIC_API_KEY",
      "models": [
        { "id": "claude-sonnet-5", "name": "Claude Sonnet 5", "pricing": { "input": 2.00, "output": 10.00 } }
      ]
    },
    {
      "id": "deepinfra",
      "name": "DeepInfra",
      "type": "openai-compatible",
      "api_key_env_var": "DEEPINFRA_API_KEY",
      "base_url": "https://api.deepinfra.com/v1/openai",
      "models": [
        { "id": "google/gemma-4-31B-it-turbo", "name": "Gemma 4 31B Turbo (DeepInfra)", "pricing": { "input": 0.09, "output": 0.34 } },
        { "id": "Qwen/Qwen3-235B-A22B-Instruct-2507", "name": "Qwen3 235B (DeepInfra)", "pricing": { "input": 0.09, "output": 0.55 } }
      ]
    },
    {
      "id": "claude-headless",
      "name": "Claude Code (subscription)",
      "type": "headless",
      "cli": "claude",
      "models": [
        { "id": "claude-sonnet-5-5", "name": "Sonnet 5.5 (headless)", "effort": "medium" }
      ]
    },
    {
      "id": "cursor-headless",
      "name": "Cursor Agent (subscription)",
      "type": "headless",
      "cli": "cursor",
      "models": [
        { "id": "grok-4.7-medium", "name": "Grok 4.7 (headless)" }
      ]
    },
    {
      "id": "local",
      "name": "Local (llama-server)",
      "type": "local",
      "base_url": "http://localhost:8080/v1",
      "api_key_env_var": "LOCAL_LLM_KEY",
      "timeout_seconds": 120,
      "models": [
        { "id": "gemma-4-31b", "name": "Gemma 4 31B (local)", "aliases": ["gemma31"] },
        { "id": "qwen3.8-27b", "name": "Qwen 3.8 27B (local)", "aliases": ["qwen27"] }
      ]
    }
  ]
}
