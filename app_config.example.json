{
  "enabled_evaluators": [
    "length",
    "paragraph",
    "dictionary",
    "glossary",
    "completeness",
    "blacklist",
    "grammar"
  ],
  "blacklist_path": "blacklist.json",
  "length_config": {
    "expected_min": 0.95,
    "expected_max": 1.3,
    "min_ratio": 0.5,
    "max_ratio": 2.0,
    "count_by": "words"
  },
  "judge_suites": {
    "default": [
      "dialogue"
    ]
  },
  "automation": {
    "exclude_groups": [
      ".backburner",
      ".published"
    ],
    "default_cli": "claude",
    "auto_apply_types": [
      "word_choice",
      "inconsistency",
      "flag"
    ],
    "confidence_floor": "high",
    "max_targets_per_run": 400,
    "deadline_minutes": 120,
    "concurrency": 5
  }
}
