{
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/scripts/hooks/compact_hint.py\" stop || exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/scripts/hooks/compact_hint.py\" precompact || exit 0",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
